local function createPart(name, size, color, parent)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.Color = color
    p.Material = Enum.Material.Plastic
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Anchored = false
    p.CanCollide = false
    p.Massless = true
    p.CastShadow = true
    p.Parent = parent
    return p
end

local function createMotor(name, part0, part1, c0, c1, parent)
    local m = Instance.new("Motor6D")
    m.Name = name
    m.Part0 = part0
    m.Part1 = part1
    m.C0 = c0
    m.C1 = c1
    m.Parent = parent or part0
    return m
end

local function clearNoob()
    if noobConn then noobConn:Disconnect() noobConn = nil end
    if noobFolder then pcall(function() noobFolder:Destroy() end) noobFolder = nil end
    noobMotors = {}
    noobParts = {}
    local char = LocalPlayer.Character
    if char then
        for obj, data in pairs(savedTransparency) do
            if obj and obj.Parent then
                pcall(function()
                    obj.Transparency = data.trans
                    if data.ltm ~= nil then
                        obj.LocalTransparencyModifier = data.ltm
                    end
                end)
            end
        end
    end
    savedTransparency = {}
end

local function hideOriginal()
    local char = LocalPlayer.Character
    if not char then return end
    savedTransparency = {}
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            savedTransparency[p] = {trans = p.Transparency, ltm = p.LocalTransparencyModifier}
            p.Transparency = 1
            p.LocalTransparencyModifier = 1
        elseif p:IsA("Decal") or p:IsA("Texture") then
            savedTransparency[p] = {trans = p.Transparency, ltm = 0}
            p.Transparency = 1
        elseif p:IsA("Accessory") or p:IsA("Accoutrement") then
            for _, h in ipairs(p:GetDescendants()) do
                if h:IsA("BasePart") then
                    savedTransparency[h] = {trans = h.Transparency, ltm = h.LocalTransparencyModifier}
                    h.Transparency = 1
                    h.LocalTransparencyModifier = 1
                end
            end
        end
    end
end

local function applyNoob()
    clearNoob()
    if not Config.CustomModel then return end

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    noobFolder = Instance.new("Folder")
    noobFolder.Name = "ReNdiCustomModel"
    noobFolder.Parent = Workspace

    local head = createPart("Head", Vector3.new(2, 1, 1), NOOB_COLORS.head, noobFolder)
    local torso = createPart("Torso", Vector3.new(2, 2, 1), NOOB_COLORS.torso, noobFolder)
    local leftArm = createPart("Left Arm", Vector3.new(1, 2, 1), NOOB_COLORS.arm, noobFolder)
    local rightArm = createPart("Right Arm", Vector3.new(1, 2, 1), NOOB_COLORS.arm, noobFolder)
    local leftLeg = createPart("Left Leg", Vector3.new(1, 2, 1), NOOB_COLORS.leg, noobFolder)
    local rightLeg = createPart("Right Leg", Vector3.new(1, 2, 1), NOOB_COLORS.leg, noobFolder)

    noobParts = {
        head = head, torso = torso,
        leftArm = leftArm, rightArm = rightArm,
        leftLeg = leftLeg, rightLeg = rightLeg,
    }

    local face = Instance.new("Decal")
    face.Name = "face"
    face.Texture = FACE_TEXTURE
    face.Face = Enum.NormalId.Front
    face.Parent = head

    noobMotors.neck = createMotor("Neck", torso, head,
        CFrame.new(0, 1, 0), CFrame.new(0, -0.5, 0))
    noobMotors.leftShoulder = createMotor("Left Shoulder", torso, leftArm,
        CFrame.new(-1, 0.5, 0), CFrame.new(0.5, 0.5, 0))
    noobMotors.rightShoulder = createMotor("Right Shoulder", torso, rightArm,
        CFrame.new(1, 0.5, 0), CFrame.new(-0.5, 0.5, 0))
    noobMotors.leftHip = createMotor("Left Hip", torso, leftLeg,
        CFrame.new(-0.5, -1, 0), CFrame.new(0, 1, 0))
    noobMotors.rightHip = createMotor("Right Hip", torso, rightLeg,
        CFrame.new(0.5, -1, 0), CFrame.new(0, 1, 0))
    noobMotors.root = createMotor("RootJoint", hrp, torso,
        CFrame.new(0, 0, 0), CFrame.new(0, 0, 0), hrp)

    hideOriginal()

    noobConn = RunService.RenderStepped:Connect(function(dt)
        if not noobFolder then return end
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return end

        local t = noobParts.torso
        if t and t.Parent then
            t.CFrame = h.CFrame
        end

        local hum = c:FindFirstChildOfClass("Humanoid")
        local speed = 0
        if hum then speed = hum.MoveDirection.Magnitude * (hum.WalkSpeed or 16) end

        if speed > 0.5 then
            walkPhase = walkPhase + dt * math.clamp(speed / 4, 2, 8)
        else
            walkPhase = walkPhase + dt * 0.5
        end

        local leftShoulderC0 = CFrame.new(-1, 0.5, 0)
        local rightShoulderC0 = CFrame.new(1, 0.5, 0)
        local leftHipC0 = CFrame.new(-0.5, -1, 0)
        local rightHipC0 = CFrame.new(0.5, -1, 0)

        if Config.WalkAnim and speed > 0.5 then
            local armSwing = math.sin(walkPhase) * math.rad(40)
            local legSwing = math.sin(walkPhase) * math.rad(45)
            leftShoulderC0 = CFrame.new(-1, 0.5, 0) * CFrame.Angles(armSwing, 0, 0)
            rightShoulderC0 = CFrame.new(1, 0.5, 0) * CFrame.Angles(-armSwing, 0, 0)
            leftHipC0 = CFrame.new(-0.5, -1, 0) * CFrame.Angles(-legSwing, 0, 0)
            rightHipC0 = CFrame.new(0.5, -1, 0) * CFrame.Angles(legSwing, 0, 0)
        end

        if Config.HoldTool then
            local tool = c:FindFirstChildOfClass("Tool")
            if tool then
                rightShoulderC0 = CFrame.new(1, 0.5, 0) * CFrame.Angles(math.rad(-90), 0, 0)
            end
        end

        if noobMotors.leftShoulder then noobMotors.leftShoulder.C0 = leftShoulderC0 end
        if noobMotors.rightShoulder then noobMotors.rightShoulder.C0 = rightShoulderC0 end
        if noobMotors.leftHip then noobMotors.leftHip.C0 = leftHipC0 end
        if noobMotors.rightHip then noobMotors.rightHip.C0 = rightHipC0 end
    end)
end

