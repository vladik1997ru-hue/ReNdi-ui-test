local FLAG_PATHS = {
    "ReNdi_subscribed.flag",
    "ReNdi_subscribed_v2.flag",
    "ReNdi/subscribed.txt",
}

local function hasSubscribed()
    if _G._ReNdiSubscribed then return true end
    if not readfile then return false end
    for _, path in ipairs(FLAG_PATHS) do
        local ok, content = pcall(function() return readfile(path) end)
        if ok and content == "1" then
            _G._ReNdiSubscribed = true
            return true
        end
    end
    return false
end

local function markSubscribed()
    _G._ReNdiSubscribed = true
    if not writefile then return end
    for _, path in ipairs(FLAG_PATHS) do
        pcall(function() writefile(path, "1") end)
    end
end

