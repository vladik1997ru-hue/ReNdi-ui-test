-- ESP
local espObjects = {}
local function cleanupFor(plr)
    if espObjects[plr] then
        for _, o in pairs(espObjects[plr]) do pcall(function() o:Remove() end) end
        espObjects[plr] = nil
    end
end
local function cleanupAll()
    for plr in pairs(espObjects) do cleanupFor(plr) end
    espObjects = {}
end
local function getObj(plr, key, kind)
    espObjects[plr] = espObjects[plr] or {}
    if not espObjects[plr][key] and Drawing then
        espObjects[plr][key] = Drawing.new(kind)
    end
    return espObjects[plr][key]
end
local function hideAll(plr)
    if not espObjects[plr] then return end
    for _, o in pairs(espObjects[plr]) do o.Visible = false end
end

RunService.RenderStepped:Connect(function()
    if not Drawing then return end
    if not Config.ESP then cleanupAll() return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if not isSpawned(plr) then cleanupFor(plr) continue end
        local char = plr.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if not hrp or not head then hideAll(plr) continue end
        local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
        if dist > Config.MaxDist then hideAll(plr) continue end
        local role = Config.ESPRoles and getRole(plr) or nil
        local color = role and roleColor(role) or Color3.fromRGB(230, 230, 230)
        local hp, hv = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6, 0))
        local bp, bv = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.2, 0))
        if not hv or not bv then hideAll(plr) continue end
        local h = math.abs(bp.Y - hp.Y)
        local w = h * 0.55
        local x = hp.X - w / 2
        local y = hp.Y
        if Config.ESPBox then
            local box = getObj(plr, "box", "Square")
            if box then
                box.Size = Vector2.new(w, h)
                box.Position = Vector2.new(x, y)
                box.Color = color
                box.Thickness = 2
                box.Filled = false
                box.Transparency = 1
                box.Visible = true
            end
        end
        if Config.ESPName then
            local name = getObj(plr, "name", "Text")
            if name then
                local roleTag = ""
                if role == "murderer" then roleTag = " [MRD]"
                elseif role == "sheriff" then roleTag = " [SHR]"
                elseif role == "innocent" then roleTag = " [INN]" end
                name.Text = plr.Name .. roleTag
                name.Position = Vector2.new(x + w / 2, y - 16)
                name.Size = 13
                name.Color = color
                name.Center = true
                name.Outline = true
                name.OutlineColor = Color3.fromRGB(0, 0, 0)
                name.Visible = true
            end
        end
        if Config.ESPDistance then
            local d = getObj(plr, "dist", "Text")
            if d then
                d.Text = math.floor(dist) .. "m"
                d.Position = Vector2.new(x + w / 2, y + h + 3)
                d.Size = 12
                d.Color = color
                d.Center = true
                d.Outline = true
                d.OutlineColor = Color3.fromRGB(0, 0, 0)
                d.Visible = true
            end
        end
    end
end)

