local function getClosestTarget()
    local closest, closestDist = nil, math.huge
    local center = viewport / 2
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isSpawned(plr) then
            local skip = false
            if Config.AIMOnlyMurderer and getRole(plr) ~= "murderer" then skip = true end
            if not skip then
                local head = plr.Character:FindFirstChild("Head")
                if head then
                    if not (Config.AIMVisible and not isVisible(head)) then
                        local pos, vis = Camera:WorldToViewportPoint(head.Position)
                        if vis then
                            local sp = Vector2.new(pos.X, pos.Y)
                            local d = (sp - center).Magnitude
                            if d < Config.FOV and d < closestDist then
                                closest, closestDist = head, d
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    if not Config.AIM then return end
    if Config.AIMRequireGun and not hasGun() then return end
    local target = getClosestTarget()
    if target then
        local cf = CFrame.new(Camera.CFrame.Position, target.Position)
        Camera.CFrame = Camera.CFrame:Lerp(cf, Config.Smooth)
    end
end)

