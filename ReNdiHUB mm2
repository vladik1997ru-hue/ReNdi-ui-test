local visitedPickups = {}

local function findPickup(maxRange)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local closest, closestDist = nil, maxRange or math.huge
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("coin") or n:find("money") or n:find("cash")
            or n:find("crystal") or n:find("diamond") or n:find("gem") then
                if not visitedPickups[obj] then
                    local d = (obj.Position - hrp.Position).Magnitude
                    if d < closestDist then
                        closest, closestDist = obj, d
                    end
                end
            end
        end
    end
    return closest
end

task.spawn(function()
    while true do
        if Config.CoinBot then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local pickup = findPickup(Config.CoinRange)
                if pickup then
                    visitedPickups[pickup] = true
                    pcall(function()
                        hrp.CFrame = CFrame.new(pickup.Position + Vector3.new(0, 2, 0))
                    end)
                    local count = 0
                    for _ in pairs(visitedPickups) do count = count + 1 end
                    if count > 100 then visitedPickups = {} end
                else
                    visitedPickups = {}
                end
            end
            task.wait(Config.CoinDelay)
        else
            task.wait(0.1)
        end
    end
end)

