local spinGyro, spinAngle = nil, 0
RunService.Heartbeat:Connect(function(dt)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if Config.Spin then
        if not spinGyro or spinGyro.Parent ~= hrp then
            if spinGyro then pcall(function() spinGyro:Destroy() end) end
            spinGyro = Instance.new("BodyGyro")
            spinGyro.MaxTorque = Vector3.new(0, math.huge, 0)
            spinGyro.P = 50000
            spinGyro.D = 500
            spinGyro.Parent = hrp
        end
        spinAngle = spinAngle + dt * Config.SpinSpeed * 5
        spinGyro.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, spinAngle, 0)
    elseif spinGyro then
        pcall(function() spinGyro:Destroy() end)
        spinGyro = nil
        spinAngle = 0
    end
end)

-- AUTO GRAB GUN
local gunGrabBusy = false
local savedOriginCF = nil

local function grabGun()
    if gunGrabBusy then return end
    gunGrabBusy = true
    task.spawn(function()
        local sheriffAlive = false
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and isSpawned(plr) then
                if getRole(plr) == "sheriff" then sheriffAlive = true break end
            end
        end
        if sheriffAlive then
            notify("шериф ещё жив")
            gunGrabBusy = false
            return
        end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then gunGrabBusy = false return end
        savedOriginCF = hrp.CFrame

        local gun
        for _, obj in ipairs(Workspace:GetChildren()) do
            local n = obj.Name:lower()
            if (n == "gun" or n:find("gun") or n:find("revolver") or n:find("pistol"))
            and (obj:IsA("Tool") or obj:IsA("Model")) then gun = obj break end
        end
        if not gun then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                local n = obj.Name:lower()
                if (n == "gun" or n:find("gun") or n:find("revolver") or n:find("pistol"))
                and (obj:IsA("Tool") or obj:IsA("Model") or obj:IsA("BasePart")) then
                    gun = obj break
                end
            end
        end
        if not gun then
            notify("пистолет не найден")
            gunGrabBusy = false
            return
        end

        local part
        if gun:IsA("Model") then
            part = gun.PrimaryPart or gun:FindFirstChildWhichIsA("BasePart")
        elseif gun:IsA("Tool") then
            part = gun:FindFirstChild("Handle") or gun:FindFirstChildWhichIsA("BasePart")
        elseif gun:IsA("BasePart") then
            part = gun
        end
        if not part then gunGrabBusy = false return end

        pcall(function()
            hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 2, 0))
        end)
        task.wait(0.3)

        if gun:IsA("Tool") then
            pcall(function()
                if gun.Parent ~= LocalPlayer.Backpack then
                    gun.Parent = LocalPlayer.Backpack
                end
            end)
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then pcall(function() hum:EquipTool(gun) end) end
        end
        task.wait(0.3)

        if savedOriginCF then
            pcall(function() hrp.CFrame = savedOriginCF end)
        end

        notify("пистолет забран")
        gunGrabBusy = false
        savedOriginCF = nil
    end)
end

