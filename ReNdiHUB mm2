local function newToggle(parent, label, getter, setter, expandContent)
    local holder = create("Frame", {
        Size = UDim2.new(1, -8, 0, 40 * UI_SCALE),
        BackgroundColor3 = Color3.fromRGB(18, 20, 25),
        BorderSizePixel = 0,
    }, parent)
    create("UICorner", { CornerRadius = UDim.new(0, 10) }, holder)

    create("TextLabel", {
        Size = UDim2.new(0.75, 0, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1, Text = label,
        TextColor3 = Color3.fromRGB(225, 225, 230),
        Font = Enum.Font.Gotham, TextSize = 13 * UI_SCALE,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, holder)

    local state = getter()
    local btn = create("TextButton", {
        Size = UDim2.new(0, 56 * UI_SCALE, 0, 26 * UI_SCALE),
        Position = UDim2.new(1, -64 * UI_SCALE, 0, 7 * UI_SCALE),
        BackgroundColor3 = state and DEEP or Color3.fromRGB(42, 44, 50),
        Text = state and "ON" or "OFF",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold, TextSize = 12 * UI_SCALE,
        BorderSizePixel = 0, AutoButtonColor = false,
    }, holder)
    create("UICorner", { CornerRadius = UDim.new(0, 9) }, btn)

    local expandFrame
    if expandContent then
        expandFrame = create("Frame", {
            Size = UDim2.new(1, -8, 0, 0),
            BackgroundColor3 = Color3.fromRGB(14, 15, 19),
            BorderSizePixel = 0, ClipsDescendants = true,
        }, parent)
        create("UICorner", { CornerRadius = UDim.new(0, 10) }, expandFrame)
        create("UIListLayout", {
            Padding = UDim.new(0, 4),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, expandFrame)
        create("UIPadding", {
            PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
            PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
        }, expandFrame)
        expandContent(expandFrame)
    end

    local expanded = state
    local function updateExpand()
        if not expandFrame then return end
        local target
        if expanded then
            target = UDim2.new(1, -8, 0,
                expandFrame.UIListLayout.AbsoluteContentSize.Y + 8)
        else
            target = UDim2.new(1, -8, 0, 0)
        end
        TweenService:Create(expandFrame, TweenInfo.new(0.35,
            Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = target,
        }):Play()
    end

    btn.MouseButton1Click:Connect(function()
        local new = not getter()
        setter(new)
        btn.BackgroundColor3 = new and DEEP or Color3.fromRGB(42, 44, 50)
        btn.Text = new and "ON" or "OFF"
        notify(label .. ": " .. (new and "вкл" or "выкл"))
        if expandFrame then
            expanded = new
            updateExpand()
        end
    end)

    if expandFrame then
        task.wait(0.1)
        updateExpand()
    end
end

local function newSlider(parent, label, min, max, getter, setter)
    local holder = create("Frame", {
        Size = UDim2.new(1, -8, 0, 56 * UI_SCALE),
        BackgroundColor3 = Color3.fromRGB(18, 20, 25),
        BorderSizePixel = 0,
    }, parent)
    create("UICorner", { CornerRadius = UDim.new(0, 10) }, holder)

    local lbl = create("TextLabel", {
        Size = UDim2.new(1, -16, 0, 20 * UI_SCALE),
        Position = UDim2.new(0, 12, 0, 4),
        BackgroundTransparency = 1,
        Text = label .. ": " .. getter(),
        TextColor3 = Color3.fromRGB(225, 225, 230),
        Font = Enum.Font.Gotham, TextSize = 12 * UI_SCALE,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, holder)

    local track = create("TextButton", {
        Size = UDim2.new(1, -24, 0, 14 * UI_SCALE),
        Position = UDim2.new(0, 12, 0, 30 * UI_SCALE),
        BackgroundColor3 = Color3.fromRGB(32, 34, 40),
        Text = "", BorderSizePixel = 0, AutoButtonColor = false,
    }, holder)
    create("UICorner", { CornerRadius = UDim.new(0, 8) }, track)
    local fill = create("Frame", {
        Size = UDim2.new((getter() - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = COL, BorderSizePixel = 0,
    }, track)
    create("UICorner", { CornerRadius = UDim.new(0, 8) }, fill)

    local dragging = false
    local function update(input)
        local rel = math.clamp(
            (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * rel)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text = label .. ": " .. val
        setter(val)
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true update(input)
        end
    end)
    track.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement) then
            update(input)
        end
    end)
    track.InputEnded:Connect(function() dragging = false end)
end

